# Secrets for the telegram-intake Edge Function.
# Copy the values you need and set them with:
#   supabase secrets set --env-file supabase/functions/telegram-intake/.env
# Never commit the filled-in file — .env is gitignored, .env.example is not.

# ── required ───────────────────────────────────────────────────────────────
# From @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram echoes it back on every webhook call; the
# function rejects requests that don't carry it. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform —
# do not set them yourself.

# ── optional ───────────────────────────────────────────────────────────────
# Voice notes stay switched off until this is set: https://console.groq.com/keys
GROQ_API_KEY=
# Swap the extraction model without touching code. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=
# Default: whisper-large-v3
GROQ_WHISPER_MODEL=
# Fallback only — the live value lives in settings.ai_confidence_threshold,
# editable from Settings → Telegram intake. Default: 0.85
AI_CONFIDENCE_THRESHOLD=
# Bootstrap allowlist for before Settings → Telegram intake has been filled in.
# Comma-separated Telegram user ids.
TELEGRAM_ALLOWED_IDS=
# Set to true to allow demo requests (x-demo-mode: 1) that skip the webhook
# secret and stub the Telegram replies. Leave unset in normal operation.
DEMO_MODE=
